L.AboutTitle = "\n\n|cff00CCFFAbout|r"
L.About = "Welcome to RSA! If you're stuck, go to the help tab or type |cff33ff99/rsa help|r. If you still aren't sure, leave me a comment on Curse at: |cff33ff99http://wow.curse.com/downloads/wow-addons/details/rsa.aspx|r. If you find a bug, or have a feature request, make a ticket on Curse at: |cff33ff99http://wow.curseforge.com/addons/rsa/tickets/|r.\n\n"

